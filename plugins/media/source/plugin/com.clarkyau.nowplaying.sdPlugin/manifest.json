{
  "SDKVersion": 1,
  "Author": "clarkyau",
  "Name": "Now Playing",
  "Description": "Album art, track info, time and progress across your keys, plus media controls. Works with Spotify, browsers and any player in the Windows volume popup - no sign-in.",
  "Icon": "static/plugin.png",
  "Category": "Now Playing",
  "CategoryIcon": "static/plugin.png",
  "CodePathWin": "plugin/index.js",
  "Version": "2.0.0",
  "URL": "",
  "OS": [
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Software": {
    "MinimumVersion": "3.10.188.226"
  },
  "Nodejs": {
    "Version": "20"
  },
  "Actions": [
    {
      "UUID": "com.clarkyau.nowplaying.art",
      "Name": "Album Art",
      "Tooltip": "The album cover. Neighbouring Album Art keys share one big picture.",
      "Icon": "static/art.png",
      "States": [
        {
          "Image": "static/art.png",
          "TitleAlignment": "bottom",
          "FontSize": "10",
          "ShowTitle": false
        }
      ],
      "Controllers": [
        "Keypad",
        "Information"
      ],
      "Settings": {},
      "DisableAutomaticStates": true,
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": true,
      "PropertyInspectorPath": "propertyInspector/index.html"
    },
    {
      "UUID": "com.clarkyau.nowplaying.info",
